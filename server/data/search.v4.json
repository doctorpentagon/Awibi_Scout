{
 "release": "AWIBI-SCOUT-CONTENT-2026.08.R2",
 "index_spec": {
  "layers": [
   {
    "layer": "L0_concept_bridge",
    "structure": "Map<normalised_phrase, {target_slug|facet, confidence}>",
    "when": "Evaluated FIRST, on the whole normalised query string",
    "cost": "O(1) hash lookup",
    "why": "Fixes 'blood drop', 'how many pints', 'set the drip', 'sugar is low'"
   },
   {
    "layer": "L1_exact_token",
    "structure": "Map<token, Posting[]>  where Posting = {id, field, tf}",
    "scoring": "BM25F, k1=1.2, b=0.75, field weights below",
    "when": "Primary retrieval for every query",
    "cost": "O(postings intersection)"
   },
   {
    "layer": "L2_prefix_trie",
    "structure": "Trie over all tokens and also_known_as phrases",
    "when": "As-you-type, from keystroke 2",
    "cost": "O(prefix length + results)",
    "why": "'tetan' -> tetanus before the user finishes typing"
   },
   {
    "layer": "L3_trigram",
    "structure": "Map<3-char gram, Set<entry_id>>  built with padded strings",
    "when": "Fires when L1 returns < 3 hits, OR query token length >= 4",
    "scoring": "Jaccard(query grams, entry grams); threshold 0.30",
    "cost": "O(grams x avg postings) — bounded, runs on <2000 entries in <10ms",
    "why": "SUB-WORD SEARCH. 'transf', 'ketoacid', 'pheochromo', 'sulph' all hit."
   },
   {
    "layer": "L4_fuzzy",
    "structure": "Damerau-Levenshtein over the trie candidate set only",
    "when": "L1+L3 still < 3 hits",
    "max_distance": "1 for tokens <=5 chars, 2 for longer",
    "why": "'diabetis', 'anaemai', 'pnemonia', 'hemorrage'"
   },
   {
    "layer": "L5_facet_navigate",
    "structure": "BROAD_CONCEPTS router (v3, extended in v4)",
    "when": "Query is a navigational noun",
    "why": "'shock', 'syndrome', 'cancer', 'trial' never return empty"
   }
  ],
  "trigram_build": {
   "normalise": "lowercase; strip accents; collapse whitespace; keep digits; map ae->ae (do NOT strip British spellings, index BOTH forms)",
   "pad": "Wrap each token as '  token ' (2 leading + 1 trailing space) so that prefix grams are captured: 'tb' -> '  t', ' tb', 'tb '",
   "source_fields": [
    "title",
    "short_title",
    "also_known_as",
    "search.terms"
   ],
   "note": "Do NOT trigram the body — it explodes the index and destroys precision. Body stays whole-token only."
  },
  "size_estimate": {
   "entries": 2000,
   "avg_indexed_chars_per_entry": 400,
   "trigram_postings": "~250k entries in the gram map",
   "serialised_gzipped": "~1.5-3 MB — ships inside the offline package",
   "build_time": "<400 ms on a mid-range Android device, done once at load"
  },
  "field_weights": {
   "title": 8.0,
   "short_title": 6.0,
   "also_known_as": 5.0,
   "terms": 4.0,
   "summary": 2.0,
   "body": 1.0,
   "flashcards": 0.5
  },
  "boosts": {
   "concept_bridge_hit": 10.0,
   "exact_title_match": 3.0,
   "phrase_match": 1.8,
   "also_known_as_exact": 2.5,
   "emergency_entry_in_emergency_context": 1.5,
   "population_matches_open_patient": 1.4,
   "nigeria_jurisdiction_at_nigerian_site": 1.3,
   "used_by_this_user_last_30_days": 1.15,
   "trending_in_this_facility_this_week": 1.1
  },
  "penalties": {
   "review_overdue": 0.85,
   "needs_local_check": 0.9
  },
  "performance_budget": {
   "p95_keystroke_to_suggestion_ms": 60,
   "p95_full_query_ms_offline": 150,
   "p95_full_query_ms_online": 500,
   "max_index_memory_mb": 40
  }
 },
