 "resolution_ladder": [
  {
   "n": 1,
   "state": "BRIDGE",
   "trigger": "query matches a concept bridge",
   "render": "open the target entry directly"
  },
  {
   "n": 2,
   "state": "EXACT",
   "trigger": "BM25F top hit >= 0.62 confidence",
   "render": "entry card"
  },
  {
   "n": 3,
   "state": "DISAMBIGUATE",
   "trigger": "ambiguous abbreviation, or top-2 within 8%",
   "render": "chooser chips; keep the user's original word visible"
  },
  {
   "n": 4,
   "state": "NAVIGATE",
   "trigger": "navigational noun",
   "render": "hub + pre-applied filter + count"
  },
  {
   "n": 5,
   "state": "SUBWORD",
   "trigger": "trigram Jaccard >= 0.30",
   "render": "'Showing partial matches for …' + results"
  },
  {
   "n": 6,
   "state": "FUZZY",
   "trigger": "edit distance within threshold",
   "render": "'Did you mean …' up to 5"
  },
  {
   "n": 7,
   "state": "GAP",
   "trigger": "nothing above threshold",
   "render": "'Nothing yet for that — try these' + nearest category chips; LOG IT"
  }
 ],
